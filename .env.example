# Copy this file to .env and fill in your credentials.
# Never commit .env to git.

# ── LLM API (DeepInfra) ──────────────────────────────────────────────────────
DEEPINFRA_API_KEY=your_deepinfra_api_key_here
DEEPINFRA_MODEL=Qwen/Qwen3-32B
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai

# ── OpenAI / ChatGPT (used for response generation in text_gen/) ─────────────
API_KEY=your_openai_api_key_here

# ── Weights & Biases (optional, for experiment tracking) ─────────────────────
WANDB_KEY=your_wandb_key_here

# ── Perspective API (toxicity scoring, emotional support scenario only) ───────
PERSPECTIVE_KEY=your_perspective_api_key_here
